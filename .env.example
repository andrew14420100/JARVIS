# AI brain: fast local conversation + NVIDIA/cloud for guarded heavy turns
JARVIS_BRAIN_MODE=cloud
JARVIS_MODEL=
JARVIS_MAX_AGENT_ITERATIONS=8
JARVIS_REQUEST_TIMEOUT_SECONDS=120
JARVIS_USER_NAME=Signore

# NVIDIA Nemotron 3 Ultra - available for guarded/tool-heavy requests.
# Create an API key privately on build.nvidia.com. Never commit the real key.
JARVIS_NVIDIA_API_KEY=
JARVIS_NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Z.AI - optional free cloud fallback
JARVIS_ZAI_API_KEY=
JARVIS_ZAI_MODEL=glm-4.7-flash

# Groq Free Plan - optional free cloud fallback
JARVIS_GROQ_API_KEY=
JARVIS_GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter free-only fallback
JARVIS_OPENROUTER_API_KEY=
JARVIS_OPENROUTER_MODEL=openrouter/free
JARVIS_CLOUD_APP_NAME=JARVIS
JARVIS_CLOUD_APP_URL=

# Low-latency conversational path. Keep LM Studio open with Qwen loaded.
# Ordinary voice chat streams locally first; guarded/tool/deep turns can still
# use NVIDIA/cloud. If local streaming is unavailable JARVIS falls back safely.
JARVIS_LM_STUDIO_FALLBACK_ENABLED=true
JARVIS_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
JARVIS_CONVERSATION_LOCAL_FIRST=true
JARVIS_CONVERSATION_MAX_MESSAGES=32

# Hybrid cognitive layer
JARVIS_OPENJARVIS_ENABLED=false
JARVIS_OPENJARVIS_AGENT=orchestrator
JARVIS_OPENJARVIS_MODEL=
JARVIS_DEEP_REASONING_ENABLED=true
JARVIS_DEEP_REASONING_MIN_SCORE=4

# Short-lived room presence context
JARVIS_PRESENCE_ENABLED=false
JARVIS_PRESENCE_CONTEXT_SECONDS=30
JARVIS_PRESENCE_MAX_ITEMS=12
JARVIS_PRESENCE_MAX_CHARS=5000

# Local memory
JARVIS_MEMORY_ENABLED=true
JARVIS_MEMORY_DB_PATH=data/jarvis_memory.sqlite3
JARVIS_MEMORY_TOP_K=4

# Windows conversational listener. The browser does NOT own the microphone.
JARVIS_BROWSER_VOICE_INPUT_ENABLED=false
JARVIS_LISTENER_REMOTE_BASE_URL=
JARVIS_LISTENER_FOLLOWUP_SILENCE_SECONDS=10
JARVIS_LISTENER_MAX_UTTERANCE_SECONDS=45
JARVIS_LISTENER_WAKE_ACK_ENABLED=true
JARVIS_LISTENER_BARGE_IN_ENABLED=true
JARVIS_LISTENER_STOP_PHRASES=jarvis stop|stop jarvis|basta jarvis|torna in standby|vai in standby
JARVIS_LISTENER_ERROR_PHRASE=Mi dispiace signore, ho avuto un problema nell'elaborare la richiesta.

# Wake word and local speech recognition.
JARVIS_VOICE_ENABLED=false
JARVIS_AUDIO_INPUT_DEVICE=
JARVIS_WAKE_MODEL=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.28
JARVIS_WAKE_MIN_RMS=0.004
JARVIS_WAKE_CHUNK_SIZE=1280
JARVIS_STT_MODEL=small
JARVIS_STT_DEVICE=auto
JARVIS_STT_COMPUTE_TYPE=float16
JARVIS_STT_LANGUAGE=it
JARVIS_STT_SILENCE_SECONDS=0.42

# The user's cloned JARVIS voice is the only stable-runtime voice.
JARVIS_TTS_MODE=cosyvoice-local
JARVIS_COSYVOICE_ENABLED=true
JARVIS_COSYVOICE_SERVICE_URL=http://127.0.0.1:8765
JARVIS_COSYVOICE_REPO_DIR=.local/cosyvoice/CosyVoice
JARVIS_COSYVOICE_MODEL_DIR=.local/cosyvoice/models/Fun-CosyVoice3-0.5B
JARVIS_COSYVOICE_REFERENCE_AUDIO=private/voices/jarvis.wav
JARVIS_COSYVOICE_REFERENCE_TEXT=private/voices/jarvis.txt
JARVIS_COSYVOICE_SPEED=1.0

# Alternative cloud voices remain disabled so JARVIS never changes timbre.
JARVIS_CLOUD_TTS_ENABLED=false
JARVIS_CLOUD_TTS_PROVIDER=fish-s2-pro
JARVIS_FISH_S2_SPACE=artificialguybr/fish-s2-pro-zero
JARVIS_FISH_S2_HF_TOKEN=
JARVIS_FISH_S2_STYLE_PROMPT=[low voice] [calm professional tone]
JARVIS_CLOUD_TTS_FALLBACK_ENABLED=false
JARVIS_EDGE_TTS_VOICE=it-IT-GiuseppeMultilingualNeural
JARVIS_EDGE_TTS_RATE=-8%
JARVIS_EDGE_TTS_PITCH=-6Hz
JARVIS_EDGE_TTS_VOLUME=+0%

# Legacy Kokoro remains installed only for non-stable/manual modes.
JARVIS_TTS_ENABLED=true
JARVIS_TTS_VOICE=im_nicola
JARVIS_TTS_SPEED=1.05
JARVIS_TTS_LANG_CODE=i

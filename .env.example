# AI brain: JARVIS-Core routes each turn to the best available specialist while
# preserving one identity, one memory and one CosyVoice voice.
JARVIS_BRAIN_MODE=cloud
JARVIS_MODEL=
JARVIS_MAX_AGENT_ITERATIONS=8
JARVIS_REQUEST_TIMEOUT_SECONDS=120
JARVIS_USER_NAME=Signore

# Optional cloud routes. Never commit real keys.
JARVIS_NVIDIA_API_KEY=
JARVIS_NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
JARVIS_ZAI_API_KEY=
JARVIS_ZAI_MODEL=glm-4.7-flash
JARVIS_GROQ_API_KEY=
JARVIS_GROQ_MODEL=qwen/qwen3.8-27b
JARVIS_OPENROUTER_API_KEY=
JARVIS_OPENROUTER_MODEL=openrouter/free
JARVIS_CLOUD_APP_NAME=JARVIS
JARVIS_CLOUD_APP_URL=

# Local open-weight model pool. Only models already served by LM Studio are
# considered; JARVIS does not try to load all of them into RAM/VRAM.
JARVIS_LM_STUDIO_FALLBACK_ENABLED=true
JARVIS_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
JARVIS_CONVERSATION_LOCAL_FIRST=true
JARVIS_LOCAL_MODEL_PRIORITY=zai-org/GLM-4.7-Flash|Qwen/Qwen3.6-35B-A3B|Qwen/Qwen3.8-27B|LGAI-EXAONE/EXAONE-4.5-33B|llm-jp/llm-jp-3-13b-instruct3|llm-jp/llm-jp-3-172b-instruct3|deepseek-ai/DeepSeek-V3.2-Exp|LGAI-EXAONE/K-EXAONE-2.0
JARVIS_VISION_MODEL_PRIORITY=LGAI-EXAONE/EXAONE-4.5-33B
JARVIS_CONVERSATION_MAX_MESSAGES=40

# JARVIS-Core federation. Simple turns use one efficient specialist. Only
# genuinely complex turns may ask a second already-served model for a silent
# internal review before the final model answers.
JARVIS_CORE_ROUTER_ENABLED=true
JARVIS_CORE_CONSENSUS_ENABLED=true
JARVIS_CORE_CONSENSUS_MIN_COMPLEXITY=3
JARVIS_CORE_ADVISOR_MAX_CHARS=1400

# Hybrid cognitive layer
JARVIS_OPENJARVIS_ENABLED=false
JARVIS_OPENJARVIS_AGENT=orchestrator
JARVIS_OPENJARVIS_MODEL=
JARVIS_DEEP_REASONING_ENABLED=true
JARVIS_DEEP_REASONING_MIN_SCORE=4

# Permanent local memory. Complete transcript is stored locally while the live
# prompt stays bounded for speed.
JARVIS_MEMORY_ENABLED=true
JARVIS_MEMORY_DB_PATH=data/jarvis_memory.sqlite3
JARVIS_MEMORY_TOP_K=8
JARVIS_MEMORY_FULL_TRANSCRIPT=true
JARVIS_MEMORY_AUTO_SEMANTIC=true
JARVIS_MEMORY_REDACT_SECRETS=true
JARVIS_MEMORY_RECENT_SEARCH_LIMIT=1200

# Persistent presence. Say Jarvis/Hey Jarvis once to activate. Silence never
# closes the active session; explicit stop/standby phrases do.
JARVIS_PERSISTENT_SESSION_ENABLED=true
JARVIS_PERSISTENT_SESSION_POLL_SECONDS=12
JARVIS_PRESENCE_ENABLED=true
JARVIS_PRESENCE_CONTEXT_SECONDS=120
JARVIS_PRESENCE_MAX_ITEMS=24
JARVIS_PRESENCE_MAX_CHARS=9000

# Windows conversational listener.
JARVIS_BROWSER_VOICE_INPUT_ENABLED=false
JARVIS_LISTENER_REMOTE_BASE_URL=
JARVIS_LISTENER_FOLLOWUP_SILENCE_SECONDS=12
JARVIS_LISTENER_MAX_UTTERANCE_SECONDS=60
JARVIS_LISTENER_WAKE_ACK_ENABLED=true
JARVIS_LISTENER_ACTIVATION_PHRASE=Sì, signore?
JARVIS_LISTENER_BARGE_IN_ENABLED=true
JARVIS_LISTENER_STOP_PHRASES=jarvis stop|stop jarvis|basta jarvis|torna in standby|vai in standby|chiudi la sessione
JARVIS_LISTENER_ERROR_PHRASE=Mi dispiace signore, non ho capito l'ultima parte.
JARVIS_LISTENER_UNAUTHORIZED_PHRASE=Mi dispiace, non posso eseguire questa richiesta.

# Initial activation + local speech recognition.
JARVIS_VOICE_ENABLED=false
JARVIS_AUDIO_INPUT_DEVICE=
JARVIS_WAKE_MODEL=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.28
JARVIS_WAKE_MIN_RMS=0.004
JARVIS_WAKE_CHUNK_SIZE=1280
JARVIS_STT_MODEL=small
JARVIS_STT_DEVICE=auto
JARVIS_STT_COMPUTE_TYPE=float16
JARVIS_STT_LANGUAGE=it
JARVIS_STT_SILENCE_SECONDS=0.55
JARVIS_STT_INCOMPLETE_PHRASE_SILENCE_SECONDS=2.5

# Speaker authorization. First clear owner turn after a verified wake may create
# the owner profile. Add other people with:
#   python -m jarvis.voice.enroll Nome --role family --seconds 12
JARVIS_SPEAKER_AUTH_ENABLED=true
JARVIS_SPEAKER_PROFILES_DIR=data/speaker_profiles
JARVIS_SPEAKER_MATCH_THRESHOLD=0.78
JARVIS_SPEAKER_AUTO_ENROLL_OWNER=true
JARVIS_SPEAKER_OWNER_NAME=Signore
JARVIS_SPEAKER_OWNER_ROLE=owner
JARVIS_PROSODY_ENABLED=true

# Natural barge-in. Recent JARVIS output is held only in RAM as an echo reference.
JARVIS_ECHO_GUARD_ENABLED=true
JARVIS_ECHO_GUARD_MAX_CORRELATION=0.82
JARVIS_BARGE_IN_MIN_RMS=0.010
JARVIS_BARGE_IN_MIN_SECONDS=0.45

# Continuous screen awareness. Only the latest downscaled frame stays in RAM and
# is sent to a multimodal model only when the request refers to the screen.
JARVIS_SCREEN_MONITOR_ENABLED=true
JARVIS_SCREEN_CAPTURE_INTERVAL_SECONDS=2
JARVIS_SCREEN_MAX_WIDTH=1280
JARVIS_SCREEN_JPEG_QUALITY=58
JARVIS_SCREEN_ATTACH_ON_VISUAL_REQUEST=true

# Important proactive system alerts only.
JARVIS_PROACTIVE_ENABLED=true
JARVIS_PROACTIVE_POLL_SECONDS=15
JARVIS_PROACTIVE_COOLDOWN_SECONDS=300
JARVIS_PROACTIVE_CPU_PERCENT=97
JARVIS_PROACTIVE_MEMORY_PERCENT=96
JARVIS_PROACTIVE_DISK_PERCENT=96
JARVIS_PROACTIVE_GPU_TEMP_C=88

# The user's cloned JARVIS voice is the only stable-runtime voice.
JARVIS_TTS_MODE=cosyvoice-local
JARVIS_COSYVOICE_ENABLED=true
JARVIS_COSYVOICE_SERVICE_URL=http://127.0.0.1:8765
JARVIS_COSYVOICE_REPO_DIR=.local/cosyvoice/CosyVoice
JARVIS_COSYVOICE_MODEL_DIR=.local/cosyvoice/models/Fun-CosyVoice3-0.5B
JARVIS_COSYVOICE_REFERENCE_AUDIO=private/voices/jarvis.wav
JARVIS_COSYVOICE_REFERENCE_TEXT=private/voices/jarvis.txt
JARVIS_COSYVOICE_SPEED=1.0

# Alternative cloud voices remain disabled so JARVIS never changes timbre.
JARVIS_CLOUD_TTS_ENABLED=false
JARVIS_CLOUD_TTS_PROVIDER=fish-s2-pro
JARVIS_FISH_S2_SPACE=artificialguybr/fish-s2-pro-zero
JARVIS_FISH_S2_HF_TOKEN=
JARVIS_FISH_S2_STYLE_PROMPT=[low voice] [calm professional tone]
JARVIS_CLOUD_TTS_FALLBACK_ENABLED=false
JARVIS_EDGE_TTS_VOICE=it-IT-GiuseppeMultilingualNeural
JARVIS_EDGE_TTS_RATE=-8%
JARVIS_EDGE_TTS_PITCH=-6Hz
JARVIS_EDGE_TTS_VOLUME=+0%

# Legacy Kokoro remains installed only for non-stable/manual modes.
JARVIS_TTS_ENABLED=true
JARVIS_TTS_VOICE=im_nicola
JARVIS_TTS_SPEED=1.05
JARVIS_TTS_LANG_CODE=i

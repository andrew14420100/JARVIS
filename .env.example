# AI brain: public cloud, no LM Studio required
JARVIS_BRAIN_MODE=cloud
JARVIS_MODEL=
JARVIS_MAX_AGENT_ITERATIONS=8
JARVIS_REQUEST_TIMEOUT_SECONDS=120
JARVIS_USER_NAME=Signore

# Groq Free Plan - primary provider
# Create a key in the Groq console and keep it only in the backend environment.
JARVIS_GROQ_API_KEY=
JARVIS_GROQ_MODEL=qwen/qwen3.8-27b

# OpenRouter free-only fallback
# JARVIS will reject paid model ids here.
JARVIS_OPENROUTER_API_KEY=
JARVIS_OPENROUTER_MODEL=openrouter/free
JARVIS_CLOUD_APP_NAME=JARVIS
JARVIS_CLOUD_APP_URL=

# Optional legacy local development fallback. Ignored while BRAIN_MODE=cloud.
JARVIS_LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Hybrid cognitive layer
JARVIS_OPENJARVIS_ENABLED=false
JARVIS_OPENJARVIS_AGENT=orchestrator
JARVIS_OPENJARVIS_MODEL=
JARVIS_DEEP_REASONING_ENABLED=true
JARVIS_DEEP_REASONING_MIN_SCORE=4

# Short-lived room presence context (RAM only; enabled automatically by jarvis.desktop)
JARVIS_PRESENCE_ENABLED=false
JARVIS_PRESENCE_CONTEXT_SECONDS=30
JARVIS_PRESENCE_MAX_ITEMS=12
JARVIS_PRESENCE_MAX_CHARS=5000

# Local memory
JARVIS_MEMORY_ENABLED=true
JARVIS_MEMORY_DB_PATH=data/jarvis_memory.sqlite3
JARVIS_MEMORY_TOP_K=4

# Local desktop voice runtime (disabled for cloud preview)
JARVIS_VOICE_ENABLED=false
JARVIS_WAKE_MODEL=hey_jarvis
JARVIS_WAKE_THRESHOLD=0.50
JARVIS_WAKE_CHUNK_SIZE=1280

# faster-whisper
JARVIS_STT_MODEL=small
JARVIS_STT_DEVICE=auto
JARVIS_STT_COMPUTE_TYPE=int8
JARVIS_STT_LANGUAGE=it

# Kokoro TTS - Italian male voice
JARVIS_TTS_ENABLED=true
JARVIS_TTS_VOICE=im_nicola
JARVIS_TTS_SPEED=1.05
JARVIS_TTS_LANG_CODE=i
